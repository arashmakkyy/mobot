{
  "action": {
    "default_icon": {
      "32": "icons/32.png",
      "48": "icons/48.png"
    },
    "default_title": "__MSG_context_menu_activate__"
  },
  "author": "Mobot contributors",
  "background": {
    "service_worker": "js/background.js"
  },
  "commands": {
    "start-stop-video-capture": {
      "description": "__MSG_menu_screencast__"
    },
    "take-screenshot-1": {
      "description": "__MSG_screenshot_menu_1__"
    },
    "take-screenshot-2": {
      "description": "__MSG_screenshot_menu_2__"
    },
    "take-screenshot-3": {
      "description": "__MSG_screenshot_menu_3__"
    },
    "take-screenshot-4": {
      "description": "__MSG_screenshot_menu_4__"
    }
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "js/frame-element-spoofer.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' blob: data:; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self' data:"
  },
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icons/128.png",
    "32": "icons/32.png",
    "48": "icons/48.png"
  },
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "permissions": [
    "webRequest",
    "scripting",
    "tabs",
    "activeTab",
    "declarativeNetRequest",
    "webNavigation",
    "storage",
    "contextMenus",
    "tabCapture",
    "offscreen",
    "commands"
  ],
  "version": "5.28.1",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/**/*",
        "fonts/icomoon.ttf",
        "css/**/*",
        "icons/**/*",
        "workers/*.js",
        "pages/permission/micro.html",
        "pages/permission/camera.html",
        "_locales/*/messages.json",
        "pages/permission/*.js"
      ]
    }
  ]
}
